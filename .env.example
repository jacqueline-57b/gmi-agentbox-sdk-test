# Copy to .env and fill in. .env is git-ignored and loaded by tests/conftest.py.

# Required for live tests. Console -> API keys -> compute -> Create API key.
GMI_AGENTBOX_API_KEY=

# Optional: point at staging instead of https://console.gmicloud.ai
GMI_AGENTBOX_BASE_URL=https://ce-tot.gmicloud-dev.com

# Optional: pin the data center / SKU live tests use. Left empty, the live
# fixtures discover the first available pair from the catalogue.
# GMI_TEST_IDC=us-central-iowa2
# GMI_TEST_INSTANCE_TYPE=gmi.sandbox.x-small

# Optional: image the test agent is built from.
# GMI_TEST_IMAGE=docker.io/library/alpine:3.20

# Optional: B-6 tenant isolation. I-01 needs an API key belonging to a DIFFERENT
# organization — the row refuses to trust one that can already see this
# organization's agents. I-02 needs something else again: a member of THIS
# organization whose role is not admin. Without each, the matching row records a
# Known gap and skips rather than passing for the wrong reason.
# GMI_AGENTBOX_API_KEY_2=
# GMI_AGENTBOX_API_KEY_MEMBER=
